{
    "name": "starprog/bible-verse-admin",
    "description": "A simple and elegant admin panel for managing Bible verses in Laravel applications",
    "type": "library",
    "keywords": ["laravel", "bible", "verses", "admin", "cms", "plugin"],
    "license": "MIT",
    "authors": [
        {
            "name": "Starprog",
            "email": "admin@starprog.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Starprog\\BibleVerseAdmin\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Starprog\\BibleVerseAdmin\\BibleVerseAdminServiceProvider"
            ]
        }
    }
}
